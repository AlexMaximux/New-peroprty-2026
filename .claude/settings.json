{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm db:*)",
      "Bash(pnpm --filter:*)",
      "Bash(npx prisma:*)",
      "Bash(npx playwright:*)",
      "Bash(docker-compose:*)",
      "Bash(docker compose:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout -b:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(rg:*)",
      "Read",
      "Edit",
      "Write"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./apps/*/.env*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "WebFetch"
    ]
  },
  "env": {
    "NODE_ENV": "development"
  },
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [
    "postgres",
    "playwright"
  ]
}
