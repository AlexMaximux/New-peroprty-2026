{
  "$schema": "https://json.schemastore.org/mcp.json",
  "_comment": "Project-scoped MCP servers for PropVest. Committed to git so the team shares the same servers. Secrets come from environment variables, never hard-coded.",
  "mcpServers": {
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://propvest:propvest@localhost:5432/propvest?schema=public"
      ],
      "env": {
        "DATABASE_URL": "postgresql://propvest:propvest@localhost:5432/propvest?schema=public"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/nersibayat/Desktop/Programing/claude code-sand"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "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"
      }
    }
  }
}
