DATABASE_URL=postgresql://propvest:propvest@localhost:5432/propvest?schema=public
JWT_ACCESS_SECRET=__change_me__
JWT_REFRESH_SECRET=__change_me__
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=__your_access_key__
S3_SECRET_KEY=__your_secret_key__
S3_BUCKET=propvest-media
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Google Maps (server-side geocoding key)
GOOGLE_MAPS_API_KEY=__your_real_key__

# Integration modes
AIRDNA_MODE=mock
PROPERTY_DATA_MODE=mock
